generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  phone     String   @unique
  name      String?
  email     String?
  createdAt DateTime @default(now()) @map("created_at")

  cart      Cart?
  wishlist  WishlistItem[]
  orders    Order[]
  reviews   Review[]

  @@map("users")
}

model Category {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  occasionTag String?   @map("occasion_tag")
  products    Product[]

  @@map("categories")
}

model Product {
  id            String   @id @default(uuid())
  title         String
  sku           String   @unique
  slug          String   @unique
  categoryId    String?  @map("category_id")
  category      Category? @relation(fields: [categoryId], references: [id])
  occasionTag   String?  @map("occasion_tag")
  mrp           Decimal  @db.Decimal(10, 2)
  price         Decimal  @db.Decimal(10, 2)
  discountPct   Int      @default(0) @map("discount_pct")
  description   String?
  images        String[]
  rating        Float    @default(0)
  reviewCount   Int      @default(0) @map("review_count")
  stock         Int      @default(0)
  isFeatured    Boolean  @default(false) @map("is_featured")
  isNewArrival  Boolean  @default(false) @map("is_new_arrival")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  cartItems     CartItem[]
  wishlistItems WishlistItem[]
  orderItems    OrderItem[]
  reviews       Review[]

  @@index([categoryId])
  @@index([createdAt])
  @@index([isFeatured])
  @@index([isNewArrival])
  @@map("products")
}

model Cart {
  id         String     @id @default(uuid())
  userId     String?    @unique @map("user_id")
  user       User?      @relation(fields: [userId], references: [id])
  guestId    String?    @unique @map("guest_id")
  couponCode String?    @map("coupon_code")
  items      CartItem[]

  @@map("carts")
}

model CartItem {
  id        String  @id @default(uuid())
  cartId    String  @map("cart_id")
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id])
  qty       Int

  @@unique([cartId, productId])
  @@map("cart_items")
}

model WishlistItem {
  id        String  @id @default(uuid())
  userId    String? @map("user_id")
  user      User?   @relation(fields: [userId], references: [id])
  guestId   String? @map("guest_id")
  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id])

  @@unique([guestId, productId])
  @@map("wishlist_items")
}

model Order {
  id                String      @id @default(uuid())
  userId            String      @map("user_id")
  user              User        @relation(fields: [userId], references: [id])
  totalMrp          Decimal     @map("total_mrp") @db.Decimal(10, 2)
  discount          Decimal     @db.Decimal(10, 2)
  shipping          Decimal     @db.Decimal(10, 2)
  totalAmount       Decimal     @map("total_amount") @db.Decimal(10, 2)
  status            String      @default("created")
  couponCode        String?     @map("coupon_code")
  razorpayOrderId   String?     @unique @map("razorpay_order_id")
  razorpayPaymentId String?     @map("razorpay_payment_id")
  createdAt         DateTime    @default(now()) @map("created_at")
  items             OrderItem[]

  @@map("orders")
}

model OtpCode {
  id         String   @id @default(uuid())
  phone      String
  codeHash   String   @map("code_hash")
  expiresAt  DateTime @map("expires_at")
  attempts   Int      @default(0)
  lastSentAt DateTime @default(now()) @map("last_sent_at")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([phone])
  @@map("otp_codes")
}

model OrderItem {
  id              String  @id @default(uuid())
  orderId         String  @map("order_id")
  order           Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId       String  @map("product_id")
  product         Product @relation(fields: [productId], references: [id])
  qty             Int
  priceAtPurchase Decimal @map("price_at_purchase") @db.Decimal(10, 2)

  @@map("order_items")
}

model Coupon {
  id           String   @id @default(uuid())
  code         String   @unique
  pctOff       Int      @map("pct_off")
  maxOff       Decimal  @map("max_off") @db.Decimal(10, 2)
  minPurchase  Decimal  @map("min_purchase") @db.Decimal(10, 2)

  @@map("coupons")
}

model Review {
  id        String   @id @default(uuid())
  productId String   @map("product_id")
  product   Product  @relation(fields: [productId], references: [id])
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id])
  rating    Int
  comment   String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([productId])
  @@map("reviews")
}
